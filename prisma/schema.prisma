generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ── Animals ──

model Animal {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  age             String
  sex             String
  // size + color come from the adoption spreadsheet but until now lived only
  // in the code-baked donkey-profiles-data.ts map. Added to the DB so the
  // profile edit UI can persist changes (e.g. updating size after a vet
  // confirms a final adult size for a young donkey).
  size            String?
  color           String?
  origin          String
  status          String   @default("Active")
  herd            String
  pen             String
  tagline         String   @default("")
  story           String[] @default([])
  sponsorable     Boolean  @default(false)
  intakeDate      String   @default("")
  adoptedFrom     String   @default("")
  behavioralNotes String   @default("")
  // Free-text fields imported 1:1 from the Donkey Adoption List spreadsheet.
  // Used for displaying the donkey's profile context that doesn't fit the
  // structured medical / hoof / weight tables. Nullable because not every
  // animal will have these populated.
  specialNeeds    String?
  medical         String?
  notes           String?
  profileImage    String?
  galleryImages   String[] @default([])
  traits          String[] @default([])
  bestFriends     String[] @default([])
  // Family links (donkey names). Seeded from the adoption sheet's
  // Relationships column; editable in-app since relationships change.
  parents         String[] @default([])
  children        String[] @default([])
  // Next scheduled care dates — set by hoof/dental logging + Joshy voice commands.
  nextHoofDue     String?
  nextDentalDue   String?

  medicalEntries MedicalEntry[]
  watchAlerts    WatchAlert[]
  feedSchedule   FeedSchedule?
  hoofVisits     HoofVisit[]
  dentalVisits   DentalVisit[]
  weighIns       WeighIn[]
  photos         Photo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Medical Entries ──

model MedicalEntry {
  id          String   @id @default(cuid())
  animal      Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId    String
  animalName  String   // denormalized for quick display
  type        String   // "Vet Visit", "Hoof & Dental", "Medication", etc.
  title       String
  date        String   // ISO date YYYY-MM-DD
  description String   @default("")
  urgent      Boolean  @default(false)
  provider    String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([animalId])
  @@index([date])
  @@index([urgent])
}

// ── Watch Alerts ──

model WatchAlert {
  id         String   @id @default(cuid())
  animal     Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId   String
  animalName String   // denormalized
  date       String   // date reported
  issue      String
  treatment  String
  assignedTo String   @default("")
  severity   String   @default("medium") // "high", "medium", "low"
  resolved   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([animalId])
  @@index([resolved])
}

// ── Tasks ──

// Recurring routine template. Active templates are materialized into
// per-day TaskCompletion rows on load (GET /api/tasks), so entering a
// routine item once makes it appear every matching day until deactivated.
model TaskTemplate {
  id               String  @id @default(cuid())
  task             String
  block            String  // "AM", "Mid", "PM" (legacy rows: "Breakfast" etc.)
  category         String  // "routine", "feeding", "treatment", etc.
  animalSpecific   String? // donkey name if animal-specific
  estimatedMinutes Int     @default(10)
  defaultAssignee  String?
  note             String?
  active           Boolean @default(true)
  // Weekdays this repeats on (JS getDay(): 0=Sun … 6=Sat). Empty = every day.
  repeatDays       Int[]    @default([])
  // ISO dates the user deleted this template's instance for — never
  // re-materialize those days.
  skipDates        String[] @default([])
  sortOrder        Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskCompletion {
  id         String   @id @default(cuid())
  templateId String?  // links to TaskTemplate if from a template
  task       String
  block      String
  category   String
  date       String   // ISO date
  assignedTo String?
  completedBy String?
  done       Boolean  @default(false)
  note       String?
  sortOrder  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One materialized instance per template per day (NULL templateId — manual
  // tasks — is exempt from the constraint).
  @@unique([templateId, date])
  @@index([date])
  @@index([date, block, sortOrder])
}

// ── Feed Schedules ──

model FeedSchedule {
  id       String @id @default(cuid())
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId String @unique
  animalName String

  // Stored as JSON — array of { item: string, amount: string }
  amPlan  Json @default("[]")
  midPlan Json @default("[]")
  pmPlan  Json @default("[]")
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Herd-level base feed plan. Each donkey's effective plan = the herd plan
// merged with their own FeedSchedule row (per-item, donkey override wins).
// Mirrors the TrimProfileOverride base+override pattern.
model HerdFeedPlan {
  id   String @id @default(cuid())
  herd String @unique // free-text herd name (matches Animal.herd)

  amPlan  Json @default("[]")
  midPlan Json @default("[]")
  pmPlan  Json @default("[]")
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Hoof & Dental Visits ──

model HoofVisit {
  id         String @id @default(cuid())
  animal     Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId   String
  animalName String
  date       String // ISO date
  provider   String
  notes      String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([animalId])
  @@index([date])
}

model DentalVisit {
  id         String @id @default(cuid())
  animal     Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId   String
  animalName String
  date       String
  provider   String
  notes      String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([animalId])
  @@index([date])
}

// ── Weight Tracking ──

model WeighIn {
  id         String  @id @default(cuid())
  animal     Animal  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId   String
  animalName String
  date       String
  weight     Float?
  unit       String  @default("lbs")
  bcs        Int?    // body condition score 1-9
  notes      String  @default("")
  recordedBy String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([animalId])
  @@index([date])
}

// ── Volunteers ──

model Volunteer {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  phone               String   @default("")
  role                String   @default("volunteer") // "admin" | "volunteer"
  status              String   @default("pending") // "active" | "inactive" | "pending"
  startDate           String
  availability        String[] @default([])
  skills              String[] @default([])
  emergencyName       String   @default("")
  emergencyPhone      String   @default("")
  emergencyRelation   String   @default("")
  notes               String   @default("")
  hoursThisMonth      Float    @default(0)
  committedHoursPerDay Float   @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Photos ──

model Photo {
  id         String   @id @default(cuid())
  animal     Animal?  @relation(fields: [animalId], references: [id], onDelete: SetNull)
  animalId   String?
  url        String
  thumbnailUrl String?
  title      String
  tags       String[] @default([])
  timestamp  DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([animalId])
}

// ── Parking Lot Entries ──

model ParkingLotEntry {
  id       String   @id @default(cuid())
  type     String   // "task", "medical", "feed", "watch", "note"
  text     String
  data     Json?    // structured metadata
  resolved Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Knowledge Base ──

model KnowledgeArticle {
  id           String   @id @default(cuid())
  title        String
  content      String   // markdown
  tags         String[] @default([])
  linkedAnimals String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Providers (Farriers, Equine Dentists, Vets) ──

model Provider {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String   // "Farrier" | "Equine Dentist" | "Vet"
  phone     String   @default("")
  notes     String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Trim Profile Overrides ──
//
// The base trim profile (protocols, pre-trim treatment, squish pads,
// recent notes, training notes) comes from the donkey-trimming-notes CSV
// and is regenerated on every parser run. When staff edit a donkey's
// trim or training protocol via the Hoof Care UI, the override is stored
// here so it survives across CSV regenerations. The animal profile page
// merges: override fields take precedence over the CSV when present.

model TrimProfileOverride {
  id                String   @id @default(cuid())
  animalName        String   @unique
  preTrimTreatment  String?
  protocols         String?
  squishPads        String?
  recentNotes       String?
  trainingNotes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Map Pens ──
//
// Physical pen boundaries drawn on the map page. Each pen belongs to a herd
// (free-text — matches existing herd names from animals.ts, e.g. "Brave",
// "Angels", "Seniors"). Multiple pens per herd are allowed. The `polygon`
// column stores a GeoJSON Polygon geometry as JSON — i.e.
//   { type: "Polygon", coordinates: [[ [lng,lat], [lng,lat], ... ]] }
// We don't use PostGIS here because we don't need spatial queries; the
// pen list is small (< 100 rows) and the map just renders all of them.

model Pen {
  id        String   @id @default(cuid())
  name      String   // "Main Pasture", "Sick Bay", "Brave AM Lot"
  herd      String   // canonical herd name; free-text, validated client-side
  polygon   Json     // GeoJSON Polygon geometry
  notes     String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([herd])
}
